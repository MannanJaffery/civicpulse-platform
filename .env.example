# Application Environment Configuration Example
# Copy to .env and adjust values for local development. Never commit .env!

# Environment Name (development | staging | production | test)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=civicpulse_user
POSTGRES_PASSWORD=civicpulse_password
POSTGRES_DB=civicpulse_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://civicpulse_user:civicpulse_password@postgres:5432/civicpulse_db

# Redis Configuration (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Triage & AI Configuration (llm | ollama | rules | simulated)
TRIAGE_PROVIDER=rules
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# Rate Limiting & Cache Configuration
RATE_LIMIT_REQUESTS_PER_MINUTE=10
STATS_CACHE_TTL_SECONDS=30

# Image Tags for Production Compose and Deployments
IMAGE_TAG=latest
